%{
#define _GNU_SOURCE
#include <stdlib.h>
#include <stdio.h>
#include <string.h>

#define VAR_NOT_FOUND 2000000000

void yyerror( const char *s );
int yylex(void);

struct s_variable {
    int offset;
    char *name;
};
typedef struct s_variable t_var;

struct ctx_node {
    struct ctx_node *next;
    struct s_variable *var;
};
typedef struct ctx_node t_cn;

t_cn *ctxt = NULL;
int params_offset = 8;
int var_offset = 0;


void delete_s_variable(t_var *var) {
    free(var->name);
    free(var);
}

void delete_ctx_node(t_cn *node) {
    if (node == NULL) return ;

    delete_ctx_node(node->next);
    delete_s_variable(node->var);
    free(node);
}

void open_ctxt() {
    delete_ctx_node(ctxt);
    params_offset = 8;
    var_offset = 0;
    ctxt = NULL;
}

void add_new_node_to_context(t_cn *new_node) {
    new_node->next = ctxt;
    ctxt = new_node;
}

t_cn *new_node(int offset, char *str) {
    t_cn *new;

    new = malloc(sizeof(t_cn));
    new->next = NULL;
    new->var = malloc(sizeof(t_var));
    new->var->name = str;
    new->var->offset = offset;
    return new;
}

void declare_variable(char *name) {
    t_cn *node = new_node(var_offset * 4, name);
    add_new_node_to_context(node);
    --var_offset;
}

void declare_params(char *name) {
    t_cn *node = new_node(params_offset * 4, name);
    add_new_node_to_context(node);
    ++params_offset;

}

int lookup(char *name) {
    t_cn *node = ctxt;

    while (node) {
        if (strcmp(node->var->name, name) == 0) {
            return node->var->offset;
        }
        node = node->next;
    }
    return VAR_NOT_FOUND;
}

%}

%right EQUAL 
%left PLUS MINUS 
%left ASTE SLASH PERCENT 

%token O_PAR 
%token C_PAR 
%token D_QUOTES 
%token S_QUOTES 
%token O_BRACKET 
%token C_BRACKET 
%token O_CURLY_BRACKET 
%token C_CURLY_BRACKET 
%token COMMA 
%token PERIOD 
%token SEMICOLON 
%token EOLN 
%token AUTO 
%token EXTRN 
%token IF 
%token ELSE 
%token FOR 
%token WHILE 
%token REPEAT 
%token SWITCH 
%token DO 
%token RETURN 
%token BREAK 
%token GOTO 
%token NEXT 
%token CASE 
%token DEFAULT 

%union { int ival; char *sval ; }

%token <ival> NB 
%token <sval> ID LONG_ID TOO_LONG_ID

/*%type <s_node> expression func_params function_call function_definition program program_elem some_params statement statement_list expression_list */
%type <sval> variable expression function_call var_declaration var_list
%%

any_program:
           /* empty */
           | program
           ;

program:
       program_elem
       | program program_elem
       ;

program_elem:
            var_declaration          { printf("           ");}
            | function_definition          { printf("           ");}
            ;


function_definition:
           ID O_PAR func_params C_PAR O_CURLY_BRACKET statement_list C_CURLY_BRACKET
           {
               open_ctxt();
               printf("%s:\n", $1);
               printf("\tret\n");
           }
           

func_params:
           /* empty */  
           | some_params
           ;

some_params:
           variable { declare_params($1); }
           | some_params COMMA variable { declare_params($3); }
           ;

variable:
        LONG_ID { printf("variable [%s]\n", $1); $$ = $1; }
        | ID { printf("variable [%s]\n", $1); $$ = $1; }
        ;

var_list:
        variable { declare_variable($1); }
        | var_list COMMA variable { declare_variable($3); }
        ;

var_declaration: AUTO var_list { $$ = $2; };
               

expression:
          function_call {
                char * s;
                printf("call %s\n", $1)
                printf("push eax\n")
            }
				
          | variable {
                int offset = lookup($1);
                if (offset == VAR_NOT_FOUND) {
                    dprintf(2, "ERROR: %s was not found in function context\n");
                    exit(2)
                }
                printf("mov eax, dword ptr[ebp %+d]\n", offset);
                printf("push eax\n");
            }
				
          | NB {
                char * s;
                asprintf(&s, "%d", $1);
                $$ = s;
			}
				
          | expression PLUS expression {
                char * s;
                asprintf(&s, "(%s + %s)", $1, $3);
                $$ = s;
			}
				
          | expression MINUS expression
           {
            char * s;
            asprintf(&s, "(%s - %s)", $1, $3);
            $$ = s;
			}
				
          | variable EQUAL expression
           {
            char * s;
            asprintf(&s, "(%s = %s)", $1, $3);
            $$ = s;
			}
				
          | expression ASTE expression
           {
            char * s;
            asprintf(&s, "(%s * %s)", $1, $3);
            $$ = s;
			}
				
          | expression PERCENT expression
           {
            char * s;
                asprintf(&s, "(%s %% %s)", $1, $3);
            $$ = s;
			}
				
          | expression SLASH expression
           {
            char * s;
            asprintf(&s, "(%s / %s)", $1, $3);
            $$ = s;
			}
				
          ;

expression_list:
               expression
               | expression_list COMMA expression
               ;

function_call: ID O_PAR expression_list C_PAR { $$ = $1 ; }
             | ID O_PAR C_PAR { $$ = $1 ; }
             ;

statement:
         var_declaration { printf("\ndeclaration : <%s>\n", $1); }
         | expression { printf("\nExpression : <%s>\n", $1); }
         ;

statement_list:
        /* empty */
        | statement_list statement SEMICOLON
        ;


%%


#include <stdio.h>
#include <ctype.h>
char *progname;

int main( int argc, char *argv[] )
{
  progname = argv[0];
  printf(".intel_syntax noprefix\n.text\n");
  yyparse();
  return 0;
}

void yyerror( const char *s ) {
  fprintf( stderr ,"%s: %s\n" , progname , s );
}

